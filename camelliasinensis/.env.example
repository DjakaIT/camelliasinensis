# Samo imena varijabli. Sve NEXT_PUBLIC_* završava u javnom bundleu: nikad ne stavljaj tajne ovdje.

# Koji adapter koristi frontend: demo | devserver
NEXT_PUBLIC_BACKEND=demo

# 1 = uključuje window.__cs (promjena zalihe iz konzole) i /dev/checkout/ (samo uz BACKEND=demo)
NEXT_PUBLIC_DEMO=1

# Adresa lokalnog mock-servera (samo za BACKEND=devserver)
NEXT_PUBLIC_DEVSERVER_URL=http://127.0.0.1:4000

# Javni URL stranice (canonical, sitemap)
NEXT_PUBLIC_SITE_URL=https://camelliasinensis.eu
