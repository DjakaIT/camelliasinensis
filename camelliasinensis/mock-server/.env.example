# Kopiraj u mock-server/.env (u .gitignore). SAMO Stripe TEST ključevi; poslužitelj odbija sk_live_/rk_live_.
# Bez ključeva mock-server radi s FAKE plaćanjem (isto kao demo).

# Stripe Dashboard (Test mode) → Developers → API keys → Secret key (sk_test_…) ili restricted key (rk_test_…)
STRIPE_SECRET_KEY=

# Ispiše ga `stripe listen --forward-to 127.0.0.1:4000/webhooks/stripe` (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Neobavezno
# PORT=4000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
